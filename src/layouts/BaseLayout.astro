---
import "../styles/global.css";

const {
  title = "(주)신화중재기술사 건축사사무소 | 주거와 도시를 위한 건축설계",
  description = "공동주택, 주거단지, 리모델링, 인허가 협의까지 실현 가능한 흐름을 설계하는 건축사사무소입니다.",
} = Astro.props;

const normalizePath = (path) => {
  if (!path) return "/";
  return path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
};

const currentPath = normalizePath(Astro.url.pathname);

const navItems = [
  { href: "/", label: "홈" },
  { href: "/about/", label: "회사소개" },
  { href: "/performance/", label: "주요 실적" },
  { href: "/portfolio/", label: "포트폴리오" },
  { href: "/contact/", label: "협업 문의" },
  { href: "/location/", label: "오시는 길" },
].map((item) => ({
  ...item,
  isActive: currentPath === normalizePath(item.href),
}));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-shell">
        <a class="brand" href="/">
          <span class="brand-mark">SHJJ</span>
          <span class="brand-name">(주)신화중재기술사 건축사사무소</span>
        </a>

        <nav class="nav">
          {
            navItems.map((item) => (
              <a
                class:list={["nav-link", item.isActive && "is-active"]}
                href={item.href}
                aria-current={item.isActive ? "page" : undefined}
              >
                <span>{item.label}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-shell">
        <div class="footer-top">
          <div class="footer-brand-block">
            <p class="brand-mark">SHJJ</p>
            <p class="footer-brand">(주)신화중재기술사 건축사사무소</p>
            <p class="footer-note">
              주거 프로젝트의 방향을 계획에서 협의와 실행까지 이어지는 설계 흐름으로 정리합니다.
            </p>
          </div>

          <a class="footer-cta" href="/contact/">협업 문의</a>
        </div>

        <div class="footer-grid">
          <div class="footer-column">
            <p class="footer-label">Explore</p>
            <div class="footer-links">
              <a href="/">홈</a>
              <a href="/about/">회사소개</a>
              <a href="/performance/">주요 실적</a>
              <a href="/portfolio/">포트폴리오</a>
              <a href="/contact/">협업 문의</a>
              <a href="/location/">오시는 길</a>
            </div>
          </div>

          <div class="footer-column">
            <p class="footer-label">Contact</p>
            <div class="footer-contact">
              <a href="mailto:shjj2014@naver.com">협업 문의: shjj2014@naver.com</a>
              <a href="tel:0222023293">전화: 02-2202-3293</a>
              <p>서울특별시 송파구 오금로 148, 302호 (05620)</p>
            </div>
          </div>
        </div>

        <p class="footer-copy">COPYRIGHT © SHJJ ARCHITECTS. ALL RIGHTS RESERVED.</p>
      </div>
    </footer>
  </body>
</html>
